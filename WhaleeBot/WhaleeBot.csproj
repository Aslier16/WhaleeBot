<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-FisheeBot-bad6becb-b049-41c0-b2d7-ca3d3a02aeb8</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aslier.DeepseekWebChatWrapper" Version="0.0.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="Config.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
</Project>
